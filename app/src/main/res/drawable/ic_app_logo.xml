<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="128dp"
    android:height="128dp"
    android:viewportWidth="128"
    android:viewportHeight="128">

    <!-- Circle Logo Badge (Prominent ~1.30x scale centered at 64,64) -->
    <group
        android:pivotX="64"
        android:pivotY="64"
        android:scaleX="1.30"
        android:scaleY="1.30">

        <!-- Outer Frosted Badge (radius 32, center 64, 64) Shadow -->
        <path
            android:fillColor="#1A4854BB"
            android:pathData="M64,33 A32,32 0 1,1 63.99,33 Z" />

        <!-- Outer Frosted Badge Fill -->
        <path
            android:pathData="M64,32 A32,32 0 1,1 63.99,32 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="64"
                    android:startY="32"
                    android:endX="64"
                    android:endY="96"
                    android:type="linear">
                    <item android:color="#F2FFFFFF" android:offset="0.0" />
                    <item android:color="#CCFFFFFF" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Outer Frosted Badge Border -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1.5"
            android:fillColor="#00000000"
            android:pathData="M64,32 A32,32 0 1,1 63.99,32 Z" />

        <!-- Inner Circle Badge (radius 19, center 64, 64) -->
        <path
            android:pathData="M64,45 A19,19 0 1,1 63.99,45 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="64"
                    android:startY="45"
                    android:endX="64"
                    android:endY="83"
                    android:type="linear">
                    <item android:color="#FFFFFF" android:offset="0.0" />
                    <item android:color="#EEF4FF" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1"
            android:fillColor="#00000000"
            android:pathData="M64,45 A19,19 0 1,1 63.99,45 Z" />

        <!-- Lightning Bolt Icon -->
        <group
            android:translateX="51.5"
            android:translateY="51"
            android:scaleX="1.04"
            android:scaleY="1.04">
            <path
                android:fillColor="#0F172A"
                android:pathData="M10.67,21h-0.21c-0.35,0 -0.62,-0.31 -0.57,-0.66l0.87,-6.34H7.5c-0.78,0 -0.99,-0.61 -0.57,-1.23l5.51,-9.5c0.23,-0.4 0.67,-0.27 0.67,0v0c0.35,0 0.62,0.31 0.57,0.66L12.81,10.27h3.51c0.78,0 0.99,0.61 0.57,1.23l-5.51,9.5c-0.18,0.31 -0.52,0 -0.71,0z" />
        </group>
    </group>
</vector>
